# ========================================================
# LifeBridge Configuration Environment Variables
# ========================================================

# Your Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model (e.g. gemini-2.5-flash or gemini-1.5-flash)
DEFAULT_MODEL=gemini-2.5-flash

# Backend server host and port
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Frontend API base URL (defaults to relative /api when proxied by Vite or Nginx)
VITE_API_URL=
